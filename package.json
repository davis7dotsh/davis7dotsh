{
	"name": "davis7dotsh",
	"private": true,
	"version": "1.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:og": "node scripts/generate-og-images.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && node scripts/check-design.mjs",
		"lint:design": "node scripts/check-design.mjs",
		"i18n:translate": "pnpm i18n:extract && node --env-file-if-exists=.env.local ./node_modules/gtx-cli/bin/main.js translate && pnpm i18n:check",
		"i18n:extract": "node scripts/extract-i18n.mjs",
		"i18n:check": "node scripts/check-i18n.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-devtools-svelte": "^0.11.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@vitejs/devtools": "^0.8.3",
		"gtx-cli": "^2.28.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.4.0"
	},
	"packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"neverthrow": "^8.2.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
