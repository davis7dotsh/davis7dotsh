{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes --package=bun@1.4.0 bun install --frozen-lockfile",
  "buildCommand": "npx --yes --package=bun@1.4.0 bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sponsors",
      "destination": "/index.html"
    },
    {
      "source": "/ai",
      "destination": "/index.html"
    },
    {
      "source": "/macos",
      "destination": "/index.html"
    },
    {
      "source": "/home-server",
      "destination": "/index.html"
    },
    {
      "source": "/karabiner",
      "destination": "/index.html"
    },
    {
      "source": "/font",
      "destination": "/index.html"
    },
    {
      "source": "/ai/march-25-2026",
      "destination": "/index.html"
    }
  ]
}
